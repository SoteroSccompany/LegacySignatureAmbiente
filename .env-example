# Mailpit (SMTP + UI de e-mails em desenvolvimento)
MAILPIT_HOST=mailpitsignature
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_USER=mailpit
MAILPIT_UI_PASS=mailpitDev@2026
MAILPIT_SMTP_USER=mailpit
MAILPIT_SMTP_PASS=mailpitDev@2026

KEY_PROXY=

API_KEY=

# addon-service (compose). WEBAPP_URL fica só no addon-service/.env — o compose
# não injeta vazio pra não apagar a URL /exec do Apps Script.
ADDON_URLSITE=
ADDON_SHA=
ADDON_ADMIN_TOKEN=

# SeaweedFS / Object Storage S3 (assinatura) — consumido pela API
# Em container: BUCKET_HOST=bucketsignatureexperts | Em host: localhost
BUCKET_HOST=
BUCKET_PORT=8333
BUCKET_USE_SSL=false
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME_WIP=wip-signatureexperts
BUCKET_NAME_VAULT=vault-signatureexperts
# Anos de retencao COMPLIANCE aplicados ao selar no Vault Bucket
BUCKET_RETENTION_YEARS=5

# FaceMatch (serviço face-match) — consumido pela API
# Em container: FACE_HOST=facematch | Em host: localhost
FACE_HOST=facematch
FACE_PORT=8085
FACE_USE_SSL=false
FACE_TIMEOUT=30000
FACE_MODEL_PACK=opencv_sface
